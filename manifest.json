{
  "manifest_version": 3,
  "name": "YouTube Timestamped Bookmarks",
  "version": "1.3",
  "description": "Bookmarks the current YouTube video with a timestamp.",
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-timestamp-bookmarker@yourdomain.com",
      "strict_min_version": "140.0"
	  "data_collection_permissions": {
        "required": ["none"]
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "bookmark_video": {
      "suggested_key": {
        "default": "Alt+Shift+X",
        "mac": "Alt+Shift+X"
      },
      "description": "Bookmark current YouTube video at timestamp"
    }
  },
  "action": {
    "default_title": "YouTube Timestamped Bookmarks"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}