{
  "manifest_version": 3,
  "name": "YT Timestamp Bookmarker",
  "version": "1.0",
  "description": "Bookmarks the current YouTube video with a timestamp.",
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "yt-timestamp-bookmarker@yourdomain.com",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "commands": {
    "bookmark_video": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Bookmark current YouTube video at timestamp"
    }
  },
  "action": {
    "default_title": "YT Timestamp Bookmarker Menu",
    "default_popup": "options.html"
  }
}